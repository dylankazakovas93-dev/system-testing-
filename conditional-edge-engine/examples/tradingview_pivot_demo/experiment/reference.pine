//@version=5
// Reference indicator (TradingView). The event-writing LLM translates this into a CAUSAL event.py.
// A pivot needs `right` future bars to confirm. The plotted triangle (offset=-right) is drawn at the
// pivot bar, but the event is only knowable when the confirming bar closes.
indicator("Confirmed Pivot Reversal (reference)", overlay = true)
left  = input.int(30, "Pivot left bars",  minval = 3)
right = input.int(15, "Pivot right bars", minval = 3)
ph = ta.pivothigh(high, left, right)
pl = ta.pivotlow(low,  left, right)
plotshape(not na(pl), "Pivot low (long)",  style = shape.triangleup,   location = location.belowbar, color = color.green, offset = -right)
plotshape(not na(ph), "Pivot high (short)", style = shape.triangledown, location = location.abovebar, color = color.red,   offset = -right)
alertcondition(not na(pl), "Long pivot confirmed",  "pivot low confirmed")
alertcondition(not na(ph), "Short pivot confirmed", "pivot high confirmed")
